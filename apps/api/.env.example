# Owner role: runs migrations (bypasses RLS)
DATABASE_URL_OWNER=postgresql+asyncpg://telusur:telusur@localhost:5441/telusur
# App role: used by the API and worker, RLS enforced
DATABASE_URL=postgresql+asyncpg://telusur_app:telusur_app@localhost:5441/telusur
REDIS_URL=redis://localhost:6390
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_DIR=./storage
EMBEDDING_MODEL=BAAI/bge-m3
CORS_ORIGINS=http://localhost:3000
# LLM (free tiers). At least one provider is required for chat.
GROQ_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_URL=http://localhost:11434
